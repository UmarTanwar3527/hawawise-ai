# Hawa AI — environment template
# Copy to .env.local and fill in values. Never commit .env.local.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser: never put a secret there.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# Newer Supabase projects issue a "publishable" key; it can be used in the
# ANON_KEY slot. Row Level Security must protect every exposed table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never import it into client code.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres connection (Connect → Session pooler). Used only by scripts/db.sh
# for migrations and tests; never read by the app. Contains the database password.
SUPABASE_DB_URL=

# Google Gemini (server only)
GEMINI_API_KEY=

# Google Maps — browser key. Restrict to Hawa AI HTTP referrers and the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Air Quality API (server only). Use a separate key restricted to the Air Quality API.
GOOGLE_AIR_QUALITY_API_KEY=

# OpenAQ v3 (server only)
OPENAQ_API_KEY=
